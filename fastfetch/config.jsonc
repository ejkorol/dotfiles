{
  "logo": {
    "type": "file",
    "source": "/Users/jason/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#F5E0DC",
      "2": "#F2CDCD",
      "3": "#F5C2E7",
      "4": "#FAB387",
      "5": "#F9E2AF",
      "6": "#A6E3A1",
      "7": "#94E2D5",
      "8": "#89DCEB",
      "9": "#74C7EC"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "Hardware"
    },
    {
      "type": "host",
      "key": "host: ",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "cpu: ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "gpu: ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "memory: ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "disk: ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "format": "Software"
    },
    {
      "type": "os",
      "key": "os: ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "kernel: ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "shell: ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "Desktop"
    },
    {
      "type": "de",
      "key": "env: ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "theme: ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "terminal: ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "Uptime"
    },
    {
      "type": "command",
      "key": "age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "uptime: ",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "datetime: ",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "circle"
    }
  ]
}
